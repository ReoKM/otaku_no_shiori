# Supabase接続情報
# このファイルは値の「登録先の見本」。実際の値は次の2箇所に設定する:
#   - ローカル開発: このファイルを .env.local にコピーしてキーを記入(.env.local はgitignore対象)
#   - 本番/プレビュー: Netlify Site settings → Environment variables
# 参照: supabase/README.md / docs/deploy/netlify.md

# SupabaseプロジェクトのURL(公開情報。フロントに埋め込まれる)
NEXT_PUBLIC_SUPABASE_URL=https://meatldiffropzstdrrsd.supabase.co

# anon public key(Supabase Project Settings → API から取得。リポジトリには書かない)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key はサーバー専用・非公開。リポジトリ・ログ・ドキュメントに絶対書かない。
# 必要になるのはW3(ゲスト→ログイン移行API)以降。Netlify環境変数にのみ設定する。
# SUPABASE_SERVICE_ROLE_KEY=
